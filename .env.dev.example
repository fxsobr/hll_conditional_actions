# Development only. Nothing here affects a deployment.
#
#   cp .env.dev.example .env.dev
#   docker compose -f compose.dev.yaml --env-file .env.dev up
#
# You almost certainly do not need this file. The defaults below are already
# what `docker compose -f compose.dev.yaml up` uses, so copy it only when you have to move
# something out of the way — a port that is taken, usually.
#
# Note the `--env-file`: Compose reads `.env` on its own, and `.env` is the
# *production* file. Passing this one explicitly is what keeps the two apart.
#
# Every name is prefixed `DEV_` for the same reason. Even if you forget the
# flag and Compose reads `.env` instead, a production `POSTGRES_USER` cannot
# reach the development database — which matters, because the postgres image
# only creates its user on first boot, so a changed name would leave an
# existing volume refusing every connection.

# ── Database ──────────────────────────────────────────────────────────────────
#
# The development database is thrown away and recreated freely; these are not
# secrets and there is no reason to change them.
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=postgres
DEV_POSTGRES_DB=hll_conditional_actions_dev

# ── Host ports ────────────────────────────────────────────────────────────────
#
# The database is published so you can point a SQL client at it. Change either
# if something on your machine already holds the port.
DEV_POSTGRES_PORT=5432
DEV_APP_PORT=4000
