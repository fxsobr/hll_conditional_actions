#: lib/hll_conditional_actions_web/recipe_text.ex:49
#, elixir-autogen, elixir-format
msgid "Best squad of the match"
msgstr "Mejor escuadra de la partida"

#: lib/hll_conditional_actions_web/recipe_text.ex:50
#, elixir-autogen, elixir-format
msgid "Join us at discord.gg/your-invite"
msgstr "Únete en discord.gg/your-invite"

#: lib/hll_conditional_actions_web/recipe_text.ex:51
#, elixir-autogen, elixir-format
msgid "MATCH TOP\nKills: {top_kills}\nSupport: {top_support}\nDefense: {top_defense}\nBest squads: {top_infantry_squads}"
msgstr "TOP DE LA PARTIDA\nBajas: {top_kills}\nApoyo: {top_support}\nDefensa: {top_defense}\nMejores escuadras: {top_infantry_squads}"

#: lib/hll_conditional_actions_web/recipe_text.ex:55
#, elixir-autogen, elixir-format
msgid "MVP of the match"
msgstr "MVP de la partida"

#: lib/hll_conditional_actions_web/recipe_text.ex:56
#, elixir-autogen, elixir-format
msgid "Melee kill! You got {target_player_name} with your {weapon}."
msgstr "¡Baja cuerpo a cuerpo! Eliminaste a {target_player_name} con tu {weapon}."

#: lib/hll_conditional_actions_web/recipe_text.ex:57
#, elixir-autogen, elixir-format
msgid "Repeated team killing"
msgstr "Fuego amigo reiterado"

#: lib/hll_conditional_actions_web/recipe_text.ex:58
#, elixir-autogen, elixir-format
msgid "Seeding reward"
msgstr "Recompensa por seeding"

#: lib/hll_conditional_actions_web/recipe_text.ex:59
#, elixir-autogen, elixir-format
msgid "Solo tanking"
msgstr "Tanque en solitario"

#: lib/hll_conditional_actions_web/recipe_text.ex:60
#, elixir-autogen, elixir-format
msgid "Squad without an officer"
msgstr "Escuadra sin oficial"

#: lib/hll_conditional_actions_web/recipe_text.ex:61
#, elixir-autogen, elixir-format
msgid "Still no officer in your squad. Next time this costs you."
msgstr "Tu escuadra sigue sin oficial. La próxima vez habrá consecuencias."

#: lib/hll_conditional_actions_web/recipe_text.ex:62
#, elixir-autogen, elixir-format
msgid "TOP PLAYERS\nKills: {top_kills}\nTeamplay: {top_teamplay}\nOffense + defense: {top_offdef}\n\nTOP SQUADS\nInfantry: {top_infantry_squads}\nArmor: {top_armor_squads}"
msgstr "TOP JUGADORES\nBajas: {top_kills}\nJuego en equipo: {top_teamplay}\nAtaque + defensa: {top_offdef}\n\nTOP ESCUADRAS\nInfantería: {top_infantry_squads}\nBlindados: {top_armor_squads}"

#: lib/hll_conditional_actions_web/recipe_text.ex:66
#, elixir-autogen, elixir-format
msgid "Team killing"
msgstr "Fuego amigo"

#: lib/hll_conditional_actions_web/recipe_text.ex:68
#, elixir-autogen, elixir-format
msgid "Thanks for commanding"
msgstr "Gracias por comandar"

#: lib/hll_conditional_actions_web/recipe_text.ex:67
#, elixir-autogen, elixir-format
msgid "Thanks for commanding this match! You have VIP for 24 hours."
msgstr "¡Gracias por comandar esta partida! Tienes VIP por 24 horas."

#: lib/hll_conditional_actions_web/recipe_text.ex:69
#, elixir-autogen, elixir-format
msgid "Thanks for helping us seed! You have VIP for 24 hours."
msgstr "¡Gracias por ayudarnos con el seeding! Tienes VIP por 24 horas."

#: lib/hll_conditional_actions_web/recipe_text.ex:70
#, elixir-autogen, elixir-format
msgid "Thanks for leading a squad"
msgstr "Gracias por liderar una escuadra"

#: lib/hll_conditional_actions_web/recipe_text.ex:71
#, elixir-autogen, elixir-format
msgid "Thanks for leading your squad this match! You have VIP for 12 hours."
msgstr "¡Gracias por liderar tu escuadra en esta partida! Tienes VIP por 12 horas."

#: lib/hll_conditional_actions_web/recipe_text.ex:75
#, elixir-autogen, elixir-format
msgid "Top support of the match"
msgstr "Mejor apoyo de la partida"

#: lib/hll_conditional_actions_web/recipe_text.ex:76
#, elixir-autogen, elixir-format
msgid "Very low level, joined recently"
msgstr "Nivel muy bajo, se unió hace poco"

#: lib/hll_conditional_actions_web/recipe_text.ex:77
#, elixir-autogen, elixir-format
msgid "Watch your fire, {player_name}. That was a team mate."
msgstr "Cuidado con el fuego, {player_name}. Era un compañero."

#: lib/hll_conditional_actions_web/recipe_text.ex:78
#, elixir-autogen, elixir-format
msgid "Welcome {player_name}! Have a good match."
msgstr "¡Bienvenido, {player_name}! Que tengas una buena partida."

#: lib/hll_conditional_actions_web/recipe_text.ex:79
#, elixir-autogen, elixir-format
msgid "Welcome! Ask your squad for help, everyone starts somewhere."
msgstr "¡Bienvenido! Pide ayuda a tu escuadra, todos empezamos en algún lado."

#: lib/hll_conditional_actions_web/recipe_text.ex:80
#, elixir-autogen, elixir-format
msgid "You are alone in an armor squad. Crew up or switch role."
msgstr "Estás solo en una escuadra de blindados. Busca tripulación o cambia de rol."

#: lib/hll_conditional_actions_web/recipe_text.ex:81
#, elixir-autogen, elixir-format
msgid "You were the MVP of this match! You have VIP for 24 hours."
msgstr "¡Fuiste el MVP de esta partida! Tienes VIP por 24 horas."

#: lib/hll_conditional_actions_web/recipe_text.ex:82
#, elixir-autogen, elixir-format
msgid "You were the best supporter of this match! You have VIP for 24 hours."
msgstr "¡Fuiste el mejor apoyo de esta partida! Tienes VIP por 24 horas."

#: lib/hll_conditional_actions_web/recipe_text.ex:86
#, elixir-autogen, elixir-format
msgid "Your achievements ({achievements_count}):\n{achievements}"
msgstr "Tus logros ({achievements_count}):\n{achievements}"

#: lib/hll_conditional_actions_web/recipe_text.ex:87
#, elixir-autogen, elixir-format
msgid "Your position this season: {season_rank}\nTop: {season_top}"
msgstr "Tu posición esta temporada: {season_rank}\nTop: {season_top}"

#: lib/hll_conditional_actions_web/recipe_text.ex:88
#, elixir-autogen, elixir-format
msgid "Your squad has no officer. Take the role or join another squad."
msgstr "Tu escuadra no tiene oficial. Toma el rol o únete a otra escuadra."

#: lib/hll_conditional_actions_web/recipe_text.ex:89
#, elixir-autogen, elixir-format
msgid "Your squad was the best of the match! You have VIP for 12 hours."
msgstr "¡Tu escuadra fue la mejor de la partida! Tienes VIP por 12 horas."
