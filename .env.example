# Copy this file to `.env` and change what the comments tell you to.
#
#   cp .env.example .env
#
# Everything here already has a working value except the three secrets under
# "Secrets", which have to be generated — the stack refuses to start without
# them, on purpose.
#
#   docker compose pull
#   docker compose up -d
#
# Docker Compose reads `.env` automatically. It is in .gitignore; keep it out
# of any repository.
#
# This file is production only. Development has its own, `.env.dev.example`,
# and does not need it to run.

# ── Version ───────────────────────────────────────────────────────────────────

# Which published images to run. Leave it alone: the version comes from the
# tag you checked out, and compose.yaml already names it. Set it only to
# pin a different one without moving the working copy.
#
#   APP_VERSION=v0.2.0

# ── Web ───────────────────────────────────────────────────────────────────────

# The hostname people will type. It is what the app uses to build its own
# URLs — the links in a Discord message, a redirect after signing in.
#
#   rules.myclan.gg   a name that points at this machine
#   192.168.1.50      its address, on a private network
#   localhost         trying it out on the machine itself
PHX_HOST=localhost

# The port to answer on. Caddy binds this and nothing else: 80 and 443 are
# left alone, so this never collides with CRCON (8010/9010) or with anything
# else already on the machine.
APP_PORT=4000

# Is something in front terminating TLS?
#
# `false` is the default, and it means the traffic to this machine is plain
# HTTP — fine on a private network, not fine on the open internet.
#
# Set it to `true` only once a proxy really is terminating TLS in front. It
# marks the session cookie `secure` and redirects plain HTTP, and a `secure`
# cookie is never sent over plain HTTP — so turning this on without the TLS
# gives you an app where signing in appears to work and then does not.
FORCE_HTTPS=false

# ── Database ──────────────────────────────────────────────────────────────────
#
# This stack runs its own PostgreSQL, on its own Docker network, and does not
# publish it to the machine. It cannot collide with the database CRCON runs —
# they never see each other. There is no reason to point this at CRCON's
# database, and doing so would be a bad idea.
POSTGRES_USER=hll_conditional_actions
# CHANGE THIS. Any long random string; nothing but the app ever types it.
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-me-a-long-random-string
POSTGRES_DB=hll_conditional_actions

# ── Secrets (required in production) ──────────────────────────────────────────
#
# Both are empty on purpose. The stack refuses to start until they are filled,
# because a guessable value here is the whole security of the app.

# Signs session cookies and LiveView payloads. Generate one with:
#
#   openssl rand -base64 64 | tr -d '\n'
#
# It has to be at least 64 characters; the command above gives 88. Paste it
# on one line.
SECRET_KEY_BASE=

# Encrypts the CRCON API keys stored in the database. Generate one with:
#
#   openssl rand -base64 32
#
# KEEP A COPY. Losing this key does not lose the database, but every CRCON key
# in it becomes unreadable and has to be entered again.
ENCRYPTION_KEY=

# ── Behaviour ─────────────────────────────────────────────────────────────────

# The language the app starts in: "en" or "pt_BR". Anybody can switch it for
# themselves from their account page afterwards.
DEFAULT_LOCALE=en

# Whether this node connects to CRCON and evaluates rules. Set it to false for
# a second node that only serves the interface, or while debugging.
ENGINE_ENABLED=true

# How many days of rule execution history to keep. Older rows are pruned
# nightly. Raise it if you want a longer audit trail; the history is what the
# metrics, the escalation ladder and the per player limits all read.
EXECUTION_RETENTION_DAYS=30

# How long to wait after a player connects before evaluating rules, in
# milliseconds. The game server needs a moment before it reports the player's
# level, clan tag and team; evaluating sooner reads all of those as
# unavailable. Raise it for a slow game server.
CONNECT_DELAY_MS=5000

# Database connection pool size. 10 is enough for a handful of servers. Raise
# it only if the logs complain about waiting for a connection.
POOL_SIZE=10
