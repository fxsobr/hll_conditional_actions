# Copy to `.env` and adjust. Docker Compose reads `.env` automatically.
#
#   cp .env.example .env
#
# The development stack works with these values as they are. The production
# stack (compose.prod.yaml) refuses to start until the secrets below are real.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hll_conditional_actions_dev
# Host port for the dev database. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# ── Web ───────────────────────────────────────────────────────────────────────
# Host port the app is published on (development only; in production only
# Caddy is published).
APP_PORT=4000

# The public hostname. It builds the app's URLs and is also the name Caddy
# gets a certificate for, so it must match how people actually reach the app.
# A real name that resolves here gets a Let's Encrypt certificate on first
# boot; "localhost" gets a local one instead.
PHX_HOST=localhost

# Ports Caddy answers on. Change them only if something else already holds 80
# and 443 — Let's Encrypt validates over 80, so moving it means no automatic
# certificate.
HTTP_PORT=80
HTTPS_PORT=443

# Where Let's Encrypt sends expiry warnings. Leave it if PHX_HOST is localhost.
ACME_EMAIL=

# ── Secrets (production) ──────────────────────────────────────────────────────
# Signs session cookies and LiveView payloads.
#   mix phx.gen.secret
SECRET_KEY_BASE=

# Encrypts CRCON API keys at rest. Losing it means re-entering every key.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ── Behaviour ─────────────────────────────────────────────────────────────────
# "en" or "pt_BR". Visitors can still switch language from their account page.
DEFAULT_LOCALE=pt_BR

# Set to false for a node that only serves the UI and does not connect to any
# CRCON server (a second web node, or while debugging).
ENGINE_ENABLED=true

# How long the rule execution history is kept.
EXECUTION_RETENTION_DAYS=30

# How long to wait after a player connects before evaluating rules. The game
# server needs a moment before it reports the player's level, clan tag and
# team; evaluating sooner would read all of those as unavailable.
CONNECT_DELAY_MS=5000

# Database connection pool size (production).
POOL_SIZE=10
