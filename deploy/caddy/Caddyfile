# Caddy in front of the release.
#
# It exists for three things the application should not be doing itself:
#
#   1. refusing floods before they reach a BEAM process
#   2. compressing responses
#   3. being the one thing that answers, so the app's own port never has to be
#      published
#
# It answers on **4000, over plain HTTP**, and asks nobody for a certificate.
# Ports 80 and 443 are left alone, which is what keeps this out of the way of
# CRCON and of anything else already on the machine.
#
# That means the traffic between a browser and this machine is not encrypted.
# On a private network, or behind something that already terminates TLS, that
# is fine. On the open internet it is not: put a proxy in front, and set
# FORCE_HTTPS=true on the app service so the session cookie is marked `secure`
# and plain HTTP is redirected.
#
# SITE_ADDRESS is still a variable, so a deployment that *does* want Caddy to
# get its own certificate can set it to a hostname and publish 80 and 443 —
# but nothing here assumes it.

{$SITE_ADDRESS::4000} {
	encode zstd gzip

	# ── Rate limiting ────────────────────────────────────────────────────────
	#
	# Needs the caddy-ratelimit module, which `deploy/caddy/Dockerfile` builds
	# in. Running stock Caddy instead is a supported choice: comment this block
	# out and the application's own limiter still counts sign in attempts, by
	# address and by account. What is lost is refusing them before they reach
	# the app.
	rate_limit {
		zone login {
			match {
				method POST
				path /login
			}
			key {remote_host}
			events 5
			window 1m
		}

		zone app {
			# Everything except the LiveView socket, which is one request that
			# then stays open — counting the messages inside it would
			# disconnect anybody who clicks quickly.
			match {
				not path /live/*
			}
			key {remote_host}
			events 300
			window 10s
		}
	}

	# ── Headers ──────────────────────────────────────────────────────────────
	#
	# The application sets its own Content-Security-Policy, Referrer-Policy and
	# Permissions-Policy; those belong with the pages and travel even when
	# Caddy is not in front. What is here is what only the edge can say.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Caddy announces itself by default; there is no reason to.
		-Server
	}

	# HSTS tells a browser to refuse plain HTTP to this host from now on, so it
	# is only correct once there really is TLS. Uncomment it together with a
	# hostname in SITE_ADDRESS.
	#
	#   header Strict-Transport-Security "max-age=31536000; includeSubDomains"


	# Digested filenames change with their content, so the browser may keep
	# them forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# An orchestrator polling every few seconds should not fill the log.
	@health path /health /health/*
	log_skip @health

	reverse_proxy app:4000 {
		# X-Forwarded-For is deliberately left to Caddy. It replaces whatever
		# the client sent with the address it is actually talking to, unless
		# that address is listed in `trusted_proxies` — so a client that sends
		# its own `X-Forwarded-For: 1.2.3.4` cannot make the application count
		# its sign in attempts against somebody else. (nginx does the opposite
		# by default, which is why the app reads only the first entry.)
		header_up X-Real-IP {remote_host}

		# A LiveView connection is idle whenever the person is reading.
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}

	log {
		output stderr
		format console
	}
}
